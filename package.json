{
  "name": "road-to-reality-playground",
  "version": "1.0.0",
  "description": "Interactive math visualizations from Penrose's Road to Reality",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "playwright test",
    "test:lifecycle": "playwright test tests/tab-lifecycle.spec.js",
    "test:lifecycle:15": "playwright test tests/tab-lifecycle.spec.js -g \"15_quaternions\"",
    "test:controls": "playwright test tests/controls-and-autoplay.spec.js",
    "test:controls:15": "playwright test tests/controls-and-autoplay.spec.js -g \"15_quaternions\"",
    "test:layout": "playwright test tests/canvas-layout.spec.js",
    "test:layout:pins": "playwright test tests/canvas-layout.spec.js -g \"layout regression pins\"",
    "test:fit": "playwright test tests/canvas-fit-and-labels.spec.js",
    "test:fit:pins": "playwright test tests/canvas-fit-and-labels.spec.js -g \"regression pins\"",
    "test:all-guards": "playwright test tests/tab-lifecycle.spec.js tests/controls-and-autoplay.spec.js tests/canvas-layout.spec.js tests/canvas-fit-and-labels.spec.js"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^4.22.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}
